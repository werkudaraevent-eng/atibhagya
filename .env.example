# Payload
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Postgres (Payload Cloud or any managed Postgres) — production.
DATABASE_URI=postgres://user:password@localhost:5432/atibhagya
# For local work without a database server, a `file:` URI runs Payload on
# SQLite instead:  DATABASE_URI=file:./atibhagya-dev.db
# Leave DATABASE_URI unset to render the marketing site from the approved
# default content with no CMS at all.

# Public site URL (used for admin CORS + absolute URLs)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Where new inquiries are emailed. Leave unset to skip the notification.
INQUIRIES_NOTIFY_EMAIL=hello@atibhagya.com

# SMTP for the application notification email (optional in development —
# without it, submissions are still stored and the email is skipped).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Atibhagya <hello@atibhagya.com>"

# Object storage for uploads. Leave S3_BUCKET unset to keep files on local disk
# (fine for development and for any host with a persistent filesystem).
# Required on Vercel, whose filesystem is read-only and ephemeral.
# Works with AWS S3, Cloudflare R2, DigitalOcean Spaces, Wasabi and Supabase
# Storage — anything with an S3-compatible endpoint.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set to false only for AWS S3 with virtual-hosted-style URLs.
S3_FORCE_PATH_STYLE=true
