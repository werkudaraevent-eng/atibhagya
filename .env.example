# ---------------------------------------------------------------------------
# Atibhagya — environment variables
#
# Three environments, three sets of values. Never share a database or a
# bucket between them: staging must be free to break without touching what
# visitors see.
#
#   local       this file's defaults; SQLite, files on disk, no email
#   staging     Vercel "staging" environment; Neon `staging` branch,
#               R2 bucket atibhagya-media-staging, staging.atibhagya.com
#   production  Vercel "production"; Neon `main` branch,
#               R2 bucket atibhagya-media, atibhagya.com
#
# Secrets go into Vercel's environment settings (or a local .env), never
# into this file and never into chat.
# ---------------------------------------------------------------------------

# Payload — a long random string; different in every environment.
#   openssl rand -base64 48
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Database.
#   local:       file:./atibhagya-dev.db   (SQLite; schema pushed automatically)
#   staging:     Neon connection string for the `staging` branch
#   production:  Neon connection string for the `main` branch
# Postgres never pushes schema: run `npm run migrate` (part of build:deploy).
DATABASE_URI=file:./atibhagya-dev.db

# The site's own origin — admin CORS, cookies, absolute URLs, sitemap.
#   local:       http://localhost:3000
#   staging:     https://staging.atibhagya.com
#   production:  https://atibhagya.com
# Leave unset on Vercel *preview* deployments; the deployment's own URL is used.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Fallback recipient for inquiry notifications; the CMS (Site settings →
# Inquiry notifications) overrides it. Point staging at the team, not the client.
INQUIRIES_NOTIFY_EMAIL=

# SMTP for notification email. Empty = inquiries are stored, no email sent.
# Resend: host smtp.resend.com, port 465, user "resend", pass = API key.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Atibhagya <hello@atibhagya.com>"

# Object storage for uploads (Cloudflare R2, S3-compatible).
# Empty S3_BUCKET = files on local disk. Required on Vercel.
# Uploads go straight from the browser to the bucket, so the bucket's CORS
# policy must allow PUT from the site's origin (see README → Deploying).
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
