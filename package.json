{
  "name": "atibhagya-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "build:deploy": "node scripts/build-deploy.mjs",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "migrate:create:staging": "tsx src/scripts/migrate-staging.ts migrate:create",
    "migrate:status:staging": "tsx src/scripts/migrate-staging.ts migrate:status",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'tests/unit/*.test.ts'",
    "test:e2e": "playwright test",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/seed.ts",
    "import:products": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/import-products.ts",
    "import:products:staging": "tsx src/scripts/on-staging.ts import:products",
    "seed:staging": "tsx src/scripts/on-staging.ts seed",
    "seed:event": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/seed-event.ts",
    "seed:event:staging": "tsx src/scripts/on-staging.ts seed:event"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/db-sqlite": "^3.92.1",
    "@payloadcms/email-nodemailer": "^3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/plugin-import-export": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/storage-s3": "^3.92.1",
    "@payloadcms/ui": "3.92.1",
    "downshift": "^9.0.8",
    "exceljs": "^4.4.0",
    "framer-motion": "^13.2.0",
    "graphql": "^16.11.0",
    "gsap": "^3.15.0",
    "next": "16.4.5",
    "payload": "3.92.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "dompurify": "^3.4.17"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^7.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
